POSTGRES_DB=gods_own_getaways
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://postgres:change-this-local-password@localhost:5432/gods_own_getaways
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_ENV=development
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_DIR=uploads
IMAGE_UPLOAD_TOKEN=generate-a-unique-random-secret
IMAGE_ALLOWED_HOSTS=images.unsplash.com
# Production S3-compatible storage:
# APP_ENV=production
# IMAGE_STORAGE_BACKEND=s3
# IMAGE_PUBLIC_BASE_URL=https://cdn.example.com/travel-images
# S3_BUCKET=your-image-bucket
# S3_REGION=your-region
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
